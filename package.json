{
  "name": "aacworkflow-mcp",
  "version": "0.2.0",
  "description": "MCP server for AACWorkflow — manage tasks (issues), agents, projects, squads, autopilots and analytics from Claude / Claude Code. Bring your own token; works across all your workspaces (companies).",
  "type": "module",
  "license": "MIT",
  "author": "AACWorkflow",
  "homepage": "https://github.com/AAChibilyaev/aacworkflow-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAChibilyaev/aacworkflow-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/AAChibilyaev/aacworkflow-mcp/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "aacworkflow", "claude", "claude-code", "agents", "tasks"],
  "bin": {
    "aacworkflow-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE", ".env.example"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "pkce-challenge": "^5.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
